@using BakerWebUI.Dtos.Products
@model List<ProductWithCategoryDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Ürün Yönetim Paneli</h4>
            <p class="card-description">
                Ürünleri bu alandan düzenleyebilirsiniz
            </p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> Fotoğraf </th>
                            <th> Ürün Adı </th>
                            <th> Fiyat </th>
                            <th> Kategori </th>
                            <th> İşlemler </th>
                        </tr>
                    </thead>
                    <tbody>
                        
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ProductId</td>
                                    <td class="py-1">
                                        <img src="@item.ImageUrl" alt="image" style="width: 50px; height: 50px; border-radius: 100%;" />
                                    </td>
                                    <td>@item.ProductName</td>
                                    <td>@item.ProductPrice ₺</td>
                                    <td>@item.CategoryName</td>
                                    <td>
                                        <a href="/AdminProduct/DeleteProduct/@item.ProductId" class="btn btn-outline-danger btn-sm">Sil</a>
                                        <a href="/AdminProduct/UpdateProduct/@item.ProductId" class="btn btn-outline-success btn-sm">Güncelle</a>
                                    </td>
                                </tr>
                            }
                       
                    </tbody>
                </table>
            </div>
            <a href="/AdminProduct/CreateProduct/" class="btn btn-outline-primary">Yeni Ürün Girişi</a>
        </div>
    </div>
</div>

