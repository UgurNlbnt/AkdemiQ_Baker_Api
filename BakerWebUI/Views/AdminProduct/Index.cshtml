@using BakerWebUI.Dtos.Products
@model List<ProductWithCategoryDto>

@{
    ViewData["Title"] = "Ürünler";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-section">
    <div class="list-header">
        <h3 class="list-title">Ürün Listesi</h3>
        <p class="list-desc">Sitenin ana sayfasındaki ürünlerinizi buradan yönetebilirsiniz.</p>
        <hr class="list-divider" />
    </div>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 5%">#</th>
                    <th style="width: 10%">RESİM</th>
                    <th style="width: 30%">ÜRÜN ADI</th>
                    <th style="width: 15%">FİYAT</th>
                    <th style="width: 15%">KATEGORİ</th>
                    <th style="width: 25%" class="text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="col-id">@item.ProductId</td>
                        <td>
                            <img src="@item.ImageUrl" class="table-img" alt="ürün resmi" />
                        </td>
                        <td class="col-name">@item.ProductName</td>
                        <td class="col-price">@item.ProductPrice ₺</td>
                        <td>
                            <span class="category-badge">@item.CategoryName</span>
                        </td>
                        <td class="text-right">
                            <a href="/AdminProduct/UpdateProduct/@item.ProductId" class="btn-action btn-update">Düzenle</a>
                            <a href="/AdminProduct/DeleteProduct/@item.ProductId" class="btn-action btn-delete">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a href="/AdminProduct/CreateProduct/" class="btn-gradient-primary">
            + Yeni Ürün Girişi
        </a>
    </div>
</div>

<style>
    /* ========== SAYFA YAPISI ========== */
    .page-section {
        background: #ffffff;
        border-radius: 18px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .list-header {
        margin-bottom: 25px;
    }

    .list-title {
        font-size: 24px;
        font-weight: 700;
        color: #2b2738;
        margin-bottom: 8px;
    }

    .list-desc {
        color: #888;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .list-divider {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, #6b4de6, transparent); /* Theme color line */
        margin: 0;
    }

    /* ========== TABLO ========== */
    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .custom-table th {
        background-color: #3b2f44; /* Dark purple/brownish */
        color: #fff;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 1px;
        padding: 16px 20px;
        border: none;
    }

    .custom-table th:first-child {
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
    }
    .custom-table th:last-child {
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .custom-table tbody tr {
        background-color: #fff;
        transition: transform 0.2s ease;
    }

    .custom-table tbody tr:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(107, 77, 230, 0.08); /* slight purple glow */
    }

    .custom-table td {
        padding: 14px 20px;
        vertical-align: middle;
        font-size: 14px;
        color: #444;
        border-top: 2px solid #d1d5db;
        border-bottom: 2px solid #d1d5db;
    }

    .custom-table td:first-child {
        border-left: 2px solid #d1d5db;
        border-top-left-radius: 12px;
        border-bottom-left-radius: 12px;
        font-weight: 600;
        color: #888;
    }

    .custom-table td:last-child {
        border-right: 2px solid #d1d5db;
        border-top-right-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .table-img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    .col-name {
        font-weight: 600;
        color: #2b2738;
    }

    .col-price {
        font-weight: 600;
    }

    .category-badge {
        background-color: #fcfaff;
        color: #d19a71; /* Orange hint to match the category look from image if wanted, or theme color */
        color: #d78f65;
        color: #6b4de6;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        border: 1px solid #dcd3ff;
    }

    .text-right {
        text-align: right;
    }

    /* ========== BUTONLAR ========== */
    .btn-action {
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
        margin-left: 6px;
    }

    /* SİL */
    .btn-delete {
        color: #ef4444;
        border-color: #fca5a5;
        background-color: #fef2f2;
    }
    .btn-delete:hover {
        background-color: #ef4444;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
    }

    /* GÜNCELLE */
    .btn-update {
        color: #10b981;
        border-color: #6ee7b7;
        background-color: #ecfdf5;
    }
    .btn-update:hover {
        background-color: #10b981;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);
    }

    /* PRIMARY BUTON */
    .btn-gradient-primary {
        background: linear-gradient(135deg, #8f7cf3, #b4a6ff); /* Using theme purple */
        color: #fff;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
        box-shadow: 0 4px 12px rgba(107, 77, 230, 0.20);
        border: none;
    }

    .btn-gradient-primary:hover {
        transform: translateY(-2px);
        color: #fff;
        box-shadow: 0 6px 15px rgba(107, 77, 230, 0.3);
    }

    .mt-4 {
        margin-top: 25px;
    }
</style>
