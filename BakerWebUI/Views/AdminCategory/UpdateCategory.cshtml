@using BakerWebUI.Dtos.Categories
@model UpdateCategoryDto
@{
    ViewData["Title"] = "Kategori Güncelle";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-section">

    <!-- ÜST BAR -->
    <div class="flex-between mb-30">

        <!-- GERİ DÖN -->
        <a href="/AdminCategory/Index" class="btn btn-gradient-back">
            <i class="fa-solid fa-arrow-left"></i> Geri Dön
        </a>
    </div>

    <!-- FORM KART -->
    <div class="form-card">

        <form method="post" action="/AdminCategory/UpdateCategory">

            <input asp-for="CategoryId" type="hidden" />

            <div class="form-group">
                <label>Kategori Adı</label>
                <input asp-for="CategoryName" class="form-input" placeholder="Kategori adını giriniz..." />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-success">
                    <i class="fa-solid fa-check"></i> Kategori Bilgisi Güncelle
                </button>
            </div>

        </form>

    </div>
</div>

<style>

    /* ========== GENEL ARKA PLAN ========== */
    body {
        background-color: #f4f4f6;
        font-family: 'Segoe UI', sans-serif;
    }

    /* ========== SAYFA YAPISI ========== */
    .page-section {
        padding: 40px;
    }

    .flex-between {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 35px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #6b4de6;
    }

    /* ========== GERİ BUTONU ========== */
    .btn-gradient-back {
        background: linear-gradient(135deg, #8f7cf3, #b4a6ff);
        color: #fff;
        padding: 10px 18px;
        border-radius: 14px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(107, 77, 230, 0.20);
    }

        .btn-gradient-back:hover {
            transform: translateY(-2px);
        }

        .btn-gradient-back:active {
            background: linear-gradient(135deg, #6b4de6, #8f7cf3);
            transform: scale(0.97);
            box-shadow: 0 2px 6px rgba(107, 77, 230, 0.35);
        }

    /* ========== FORM KARTI ========== */
    .form-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 35px;
        max-width: 720px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #555;
            font-weight: 600;
        }

    /* ========== INPUTLAR ========== */
    .form-input,
    .form-textarea {
        width: 100%;
        padding: 12px 14px;
        background: #f9f9fb;
        border: 1px solid #ddd;
        border-radius: 12px;
        color: #333;
        transition: all 0.2s ease;
    }

        .form-input:focus,
        .form-textarea:focus {
            border-color: #6b4de6;
            box-shadow: 0 0 0 3px rgba(107, 77, 230, 0.1);
            outline: none;
        }

    /* ========== FORM AKSİYON ALANI ========== */
    .form-actions {
        margin-top: 30px;
        text-align: right;
    }

    /* ========== KAYDET BUTONU ========== */
    .btn-success {
        background: #86efac;
        color: #14532d;
        padding: 12px 24px;
        border-radius: 14px;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 4px 10px rgba(34, 197, 94, 0.20);
    }

        .btn-success:hover {
            transform: translateY(-2px);
        }

        .btn-success:active {
            background: #22c55e;
            color: #ffffff;
            transform: scale(0.96);
            box-shadow: 0 2px 6px rgba(34, 197, 94, 0.35);
        }

    /* ========== İKONLARI KALDIR ========== */
    .btn-gradient-back i,
    .btn-success i {
        display: none !important;
    }

</style>
