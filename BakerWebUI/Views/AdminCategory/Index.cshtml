@using BakerWebUI.Dtos.Categories
@model List<ResultCategoryDto>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title"> Kategori Yönetim Paneli</h4>
            <p class="card-description">
                Kategorileri bu alandan düzenleyebilirsiniz
            </p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> Kategori Adı </th>
                            
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CategoryId</td>
                                <td>@item.CategoryName</td>
                                <td>
                                    <a href="/AdminCategory/DeleteCategory/@item.CategoryId" class="btn btn-outline-danger btn-sm">Sil</a>
                                    <a href="/AdminCategory/UpdateCategory/@item.CategoryId" class="btn btn-outline-success btn-sm">Güncelle</a>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <a href="/AdminCategory/CreateCategory/" class="btn btn-outline-primary">Yeni Kategori Girişi</a>
        </div>
    </div>
</div>

