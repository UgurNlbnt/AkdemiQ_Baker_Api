@model List<BakerWebUI.Dtos.Chefs.ResultChefDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Şef Yönetim Paneli</h4>
            <p class="card-description">
                Şefleri bu alandan düzenleyebilirsiniz
            </p>
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th> # </th>
                            <th> Fotoğraf </th>
                            <th> Ad Soyad </th>
                            <th> Ünvan </th>
                            <th> İşlemler </th>
                        </tr>
                    </thead>
                    <tbody>
                        
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.ChefId</td>
                                    <td class="py-1">
                                        <img src="@item.ImageUrl" alt="image" style="width: 50px; height: 50px; border-radius: 100%;" />
                                    </td>
                                    <td>@item.Name</td>
                                    <td>@item.Title</td>
                                    <td>
                                        <a href="/AdminChef/DeleteChef/@item.ChefId" class="btn btn-outline-danger btn-sm">Sil</a>
                                        <a href="/AdminChef/UpdateChef/@item.ChefId" class="btn btn-outline-success btn-sm">Güncelle</a>
                                    </td>
                                </tr>
                            }
                       
                    </tbody>
                </table>
            </div>
            <a href="/AdminChef/CreateChef/" class="btn btn-outline-primary">Yeni Şef Girişi</a>
        </div>
    </div>
</div>
