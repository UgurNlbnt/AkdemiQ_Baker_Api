@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

@await Component.InvokeAsync("_DefaultHeadComponentPartial")

<body>

    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-grow text-primary" role="status"></div>
    </div>
    <!-- Spinner End -->
    <!-- Topbar Start -->
    @await Component.InvokeAsync("_DefaultTopbarComponentPartial")
    <!-- Topbar End -->
    <!-- Navbar Start -->
    @await Component.InvokeAsync("_DefaultNavbarComponentPartial")
    <!-- Navbar End -->
    <!-- Home / Carousel Start -->
    <section id="home">
        @await Component.InvokeAsync("_DefaultFeatureComponentPartial")
    </section>
    <!-- Home / Carousel End -->
    <!-- Facts Start -->
    <section id="statistics">
        @await Component.InvokeAsync("_DefaultStatisticComponentPartial")
    </section>
    <!-- Facts End -->
    <!-- About Start -->
    <section id="about">
        @await Component.InvokeAsync("_DefaultAboutComponentPartial")
    </section>
    <!-- About End -->
    <!-- Product Start -->
    <section id="products">
        @await Component.InvokeAsync("_DefaultProductComponentPartial")
    </section>
    <!-- Product End -->
    <!-- Service Start -->
    <section id="services">
        @await Component.InvokeAsync("_DefaultServiceComponentPartial")
    </section>
    <!-- Service End -->
    <!-- Team Start -->
    <section id="team">
        @await Component.InvokeAsync("_DefaultChefComponentPartial")
    </section>
    <!-- Team End -->
    <!-- Testimonial Start -->
    <section id="testimonials">
        @await Component.InvokeAsync("_DefaultTestimonialComponentPartial")
    </section>
    <!-- Testimonial End -->
    <!-- Contact / Footer Start -->
    <section id="contact">
        @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    </section>
    <!-- Contact / Footer End -->
    <!-- Copyright -->
    <div class="container-fluid copyright text-light py-4 wow fadeIn" data-wow-delay="0.1s">
        <div class="container">
            <div class="row">
                <div class="col-md-6 text-center text-md-start mb-3 mb-md-0">
                    &copy; <a href="#">Your Site Name</a>, All Right Reserved.
                </div>
                <div class="col-md-6 text-center text-md-end">
                    Designed By <a href="https://htmlcodex.com">HTML Codex</a>
                    <br />
                    Distributed By: <a class="border-bottom" href="https://themewagon.com" target="_blank">ThemeWagon</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Back to Top -->
    <a href="#home" class="btn btn-lg btn-primary btn-lg-square rounded-circle back-to-top">
        <i class="bi bi-arrow-up"></i>
    </a>

    <!-- Scripts -->
    @await Component.InvokeAsync("_DefaultScriptComponentPartial")

</body>
</html>
