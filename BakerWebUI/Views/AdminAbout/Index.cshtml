@using BakerWebUI.Dtos.About
@model List<ResultAboutDto>
@{
    ViewData["Title"] = "Hakkımızda Yönetimi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-section">
    <div class="list-header">
        <h3 class="list-title">Hakkımızda (Hakkımızda Blokları)</h3>
        <p class="list-desc">Sitenizdeki Hakkımızda kısmını buradan yönetebilir, alt detaylarını ekleyebilirsiniz.</p>
        <hr class="list-divider" />
    </div>

    <div class="table-container">
        <table class="custom-table">
            <thead>
                <tr>
                    <th style="width: 5%">#</th>
                    <th style="width: 25%">BAŞLIK</th>
                    <th style="width: 35%">AÇIKLAMA</th>
                    <th style="width: 35%" class="text-right">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="col-id">@item.AboutId</td>
                            <td class="col-name">@item.Title</td>
                            <td>@(item.Description.Length > 40 ? item.Description.Substring(0, 40) + "..." : item.Description)</td>
                            <td class="text-right">
                                <a href="/AdminAboutDetail/Index?aboutId=@item.AboutId" class="btn-action btn-detail">Detayları Yönet</a>
                                <a href="/AdminAbout/UpdateAbout/@item.AboutId" class="btn-action btn-update">Düzenle</a>
                                <a href="/AdminAbout/DeleteAbout/@item.AboutId" class="btn-action btn-delete">Sil</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4">
        <a href="/AdminAbout/CreateAbout/" class="btn-gradient-primary">
            + Yeni Hakkımızda Ekle
        </a>
    </div>
</div>

<style>
    /* ========== SAYFA YAPISI ========== */
    .page-section {
        background: #ffffff;
        border-radius: 18px;
        padding: 35px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    }

    .list-header {
        margin-bottom: 25px;
    }

    .list-title {
        font-size: 24px;
        font-weight: 700;
        color: #2b2738;
        margin-bottom: 8px;
    }

    .list-desc {
        color: #888;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .list-divider {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, #6b4de6, transparent); /* Theme color line */
        margin: 0;
    }

    /* ========== TABLO ========== */
    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .custom-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 12px;
    }

    .custom-table th {
        background-color: #3b2f44;
        color: #fff;
        font-size: 11px;
        text-transform: uppercase;
        font-weight: 600;
        letter-spacing: 1px;
        padding: 16px 20px;
        border: none;
    }

    .custom-table th:first-child {
        border-top-left-radius: 10px;
        border-bottom-left-radius: 10px;
    }
    .custom-table th:last-child {
        border-top-right-radius: 10px;
        border-bottom-right-radius: 10px;
    }

    .custom-table tbody tr {
        background-color: #fff;
        transition: transform 0.2s ease;
    }

    .custom-table tbody tr:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 15px rgba(107, 77, 230, 0.08);
    }

    .custom-table td {
        padding: 14px 20px;
        vertical-align: middle;
        font-size: 14px;
        color: #444;
        border-top: 2px solid #d1d5db;
        border-bottom: 2px solid #d1d5db;
    }

    .custom-table td:first-child {
        border-left: 2px solid #d1d5db;
        border-top-left-radius: 12px;
        border-bottom-left-radius: 12px;
        font-weight: 600;
        color: #888;
    }

    .custom-table td:last-child {
        border-right: 2px solid #d1d5db;
        border-top-right-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .col-name {
        font-weight: 600;
        color: #2b2738;
    }

    .text-right {
        text-align: right;
    }

    /* ========== BUTONLAR ========== */
    .btn-action {
        padding: 8px 18px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 13px;
        border: 1.5px solid transparent;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-block;
        margin-left: 6px;
    }

    /* SİL */
    .btn-delete {
        color: #ef4444;
        border-color: #fca5a5;
        background-color: #fef2f2;
    }
    .btn-delete:hover {
        background-color: #ef4444;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
    }

    /* GÜNCELLE */
    .btn-update {
        color: #10b981;
        border-color: #6ee7b7;
        background-color: #ecfdf5;
    }
    .btn-update:hover {
        background-color: #10b981;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(16, 185, 129, 0.2);
    }
    
    /* DETAYLARI YÖNET */
    .btn-detail {
        color: #3b82f6;
        border-color: #93c5fd;
        background-color: #eff6ff;
    }
    .btn-detail:hover {
        background-color: #3b82f6;
        color: #ffffff;
        transform: translateY(-2px);
        box-shadow: 0 4px 10px rgba(59, 130, 246, 0.2);
    }

    /* PRIMARY BUTON */
    .btn-gradient-primary {
        background: linear-gradient(135deg, #8f7cf3, #b4a6ff);
        color: #fff;
        padding: 12px 24px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        display: inline-block;
        box-shadow: 0 4px 12px rgba(107, 77, 230, 0.20);
        border: none;
    }

    .btn-gradient-primary:hover {
        transform: translateY(-2px);
        color: #fff;
        box-shadow: 0 6px 15px rgba(107, 77, 230, 0.3);
    }

    .mt-4 {
        margin-top: 25px;
    }
</style>
