@model BakerWebUI.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="page-header">
            <h3 class="page-title">
                <span class="page-title-icon bg-gradient-primary text-white me-2">
                    <i class="mdi mdi-home"></i>
                </span> Dashboard
            </h3>
            <nav aria-label="breadcrumb">
                <ul class="breadcrumb">
                    <li class="breadcrumb-item active" aria-current="page">
                        <span></span>Proje Özeti <i class="mdi mdi-alert-circle-outline icon-sm text-primary align-middle"></i>
                    </li>
                </ul>
            </nav>
        </div>

        <div class="row">
            <div class="col-md-4 stretch-card grid-margin">
                <div class="card bg-gradient-danger card-img-holder text-white">
                    <div class="card-body">
                        <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/dashboard/circle.svg" class="card-img-absolute" alt="circle-image" />
                        <h4 class="font-weight-normal mb-3">
                            Ürünler <i class="mdi mdi-cupcake mdi-24px float-end"></i>
                        </h4>
                        <h2 class="mb-5">@Model.ProductCount</h2>
                        <h6 class="card-text">Kayıtlı ürün sayısı</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-4 stretch-card grid-margin">
                <div class="card bg-gradient-info card-img-holder text-white">
                    <div class="card-body">
                        <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/dashboard/circle.svg" class="card-img-absolute" alt="circle-image" />
                        <h4 class="font-weight-normal mb-3">
                            Kategoriler <i class="mdi mdi-format-list-bulleted mdi-24px float-end"></i>
                        </h4>
                        <h2 class="mb-5">@Model.CategoryCount</h2>
                        <h6 class="card-text">Ürün kategorisi</h6>
                    </div>
                </div>
            </div>
            <div class="col-md-4 stretch-card grid-margin">
                <div class="card bg-gradient-success card-img-holder text-white">
                    <div class="card-body">
                        <img src="~/PurpleAdmin-Free-Admin-Template-1.0.0/assets/images/dashboard/circle.svg" class="card-img-absolute" alt="circle-image" />
                        <h4 class="font-weight-normal mb-3">
                            Gelen Mesajlar <i class="mdi mdi-message-text-outline mdi-24px float-end"></i>
                        </h4>
                        <h2 class="mb-5">@Model.MessageCount</h2>
                        <h6 class="card-text">Ziyaretçi mesajı</h6>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-3 stretch-card grid-margin">
                <div class="card dashboard-stat-card">
                    <div class="card-body">
                        <p class="text-muted mb-1">Şef Sayısı</p>
                        <h3 class="mb-0">@Model.ChefCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 stretch-card grid-margin">
                <div class="card dashboard-stat-card">
                    <div class="card-body">
                        <p class="text-muted mb-1">Abone Sayısı</p>
                        <h3 class="mb-0">@Model.SubscriberCount</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 stretch-card grid-margin">
                <div class="card dashboard-stat-card">
                    <div class="card-body">
                        <p class="text-muted mb-1">Ortalama Ürün Fiyatı</p>
                        <h3 class="mb-0">@Model.AverageProductPrice.ToString("C")</h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3 stretch-card grid-margin">
                <div class="card dashboard-stat-card">
                    <div class="card-body">
                        <p class="text-muted mb-1">Toplam İçerik</p>
                        <h3 class="mb-0">@(Model.ProductCount + Model.CategoryCount + Model.ChefCount + Model.MessageCount + Model.SubscriberCount)</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-7 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="card-title mb-0">Son Eklenen Ürünler</h4>
                            <a href="/AdminProduct/Index" class="btn btn-sm btn-gradient-primary">Tümünü Gör</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Ürün</th>
                                        <th>Kategori</th>
                                        <th class="text-end">Fiyat</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentProducts.Any())
                                    {
                                        foreach (var item in Model.RecentProducts)
                                        {
                                            <tr>
                                                <td>@item.ProductName</td>
                                                <td>@(item.CategoryName ?? "Kategori yok")</td>
                                                <td class="text-end">@item.ProductPrice.ToString("C")</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted">Henüz ürün bulunamadı.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="card-title mb-0">Kategori Dağılımı</h4>
                            <span class="text-muted small">@Model.CategoryCount kategori</span>
                        </div>
                        @if (Model.Categories.Any())
                        {
                            foreach (var category in Model.Categories)
                            {
                                var productCount = Model.Products.Count(x => x.CategoryName == category.CategoryName);
                                var width = Model.ProductCount > 0 ? productCount * 100 / Model.ProductCount : 0;
                                <div class="mb-4">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span>@category.CategoryName</span>
                                        <span class="text-muted">@productCount ürün</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar bg-gradient-primary" role="progressbar" style="width:@width%"></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">Henüz kategori bulunamadı.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 grid-margin">
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="card-title mb-0">Son Gelen Mesajlar</h4>
                            <a href="/AdminMessage/Index" class="btn btn-sm btn-gradient-primary">Mesajlara Git</a>
                        </div>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Ad Soyad</th>
                                        <th>E-posta</th>
                                        <th>Konu</th>
                                        <th>Mesaj</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.RecentMessages.Any())
                                    {
                                        foreach (var item in Model.RecentMessages)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                                <td>@item.Email</td>
                                                <td>@item.Subject</td>
                                                <td>@item.Message</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted">Henüz mesaj bulunamadı.</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<style>
    .dashboard-stat-card {
        border: 0;
        box-shadow: 0 8px 24px rgba(43, 39, 56, 0.08);
    }

    .dashboard-stat-card h3 {
        color: #2b2738;
        font-weight: 700;
    }

    .table td,
    .table th {
        white-space: normal;
        vertical-align: middle;
    }
</style>
