@using BakerWebUI.Dtos.About
@model List<ResultAboutDto>

<div class="container-xxl py-6">
    <div class="container">
        <div class="row g-5">
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="row img-twice position-relative h-100">
                    @foreach(var item in Model)
                    {
                        <div class="col-6 align-self-start">
                            <img class="img-fluid rounded" src="@item.ImageUrl" alt="">
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="h-100">
                    <p class="text-primary text-uppercase mb-2">// HAKKIMIZDA</p>
                    @foreach (var item in Model)
                    {
                        <h1 class="display-6 mb-4">@item.Title</h1>
                        <p>@item.Description</p>

                        @if (item.DetailDescription != null && item.DetailDescription.Any())
                        {
                            <div class="row g-2 mb-4">
                                @foreach (var detail in item.DetailDescription)
                                {
                                    <div class="col-sm-6">
                                        <i class="fa fa-check text-primary me-2"></i>@detail
                                    </div>
                                }
                            </div>
                        }
                    }

                    
                    <a class="btn btn-primary rounded-pill py-3 px-5" href="">Okuyun</a>
                </div>
            </div>
        </div>
    </div>
</div>