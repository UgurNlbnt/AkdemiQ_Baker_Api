@using BakerWebUI.Dtos.Testimonial
@model List<ResultTestimonialDto> 

<div class="container-xxl bg-light my-6 py-6 pb-0">
    <div class="container">
        <div class="text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <p class="text-primary text-uppercase mb-2">Referanslarımızın Görüşleri</p>
            <h1 class="display-6 mb-4">Yıllardır Değişmeyen Lezzet, Binlerce Mutlu Müdavim</h1>
        </div>
        
            <div class="owl-carousel testimonial-carousel wow fadeInUp" data-wow-delay="0.1s">
            @foreach (var item in Model)
            {
                <div class="testimonial-item bg-white rounded p-4">
                    <div class="d-flex align-items-center mb-4">
                        <img class="flex-shrink-0 rounded-circle border p-1" src="@item.ImageUrl" alt="">
                        <div class="ms-4">
                            <h5 class="mb-1">@item.Name</h5>
                            <span>@item.Title</span>
                        </div>
                    </div>
                    <p class="mb-0">@item.Description</p>
                </div>
            }
            </div>
       
        
        <div class="bg-primary text-light rounded-top p-5 my-6 mb-0 wow fadeInUp" data-wow-delay="0.1s">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <h1 class="display-4 text-light mb-0">Bültenimize Abone Olun</h1>
                </div>
                <div class="col-md-6 text-md-end">
                    <div class="position-relative">
                        <input id="txtEmail" class="form-control bg-transparent border-light w-100 py-3 ps-4 pe-5" type="text" placeholder="Emaliniz" autocomplete="off">
                        <button id="btnSubscribe" type="button" class="btn btn-dark py-2 px-3 position-absolute top-0 end-0 mt-2 me-2">Kaydol</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var btn = document.getElementById("btnSubscribe");
        if (btn) {
            btn.addEventListener("click", function () {
                var emailInput = document.getElementById("txtEmail").value;

                if (!emailInput || emailInput.trim() === "") {
                    Swal.fire({
                        icon: "warning",
                        title: "Eksik Bilgi",
                        text: "Lütfen bir e-posta adresi giriniz."
                    });
                    return;
                }

                var subscribeData = {
                    Email: emailInput.trim()
                };

                $.ajax({
                    url: "/Default/Subscribe",
                    type: "POST",
                    data: subscribeData,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                icon: "success",
                                title: "Başarılı",
                                text: response.message
                            });
                            document.getElementById("txtEmail").value = "";
                        } else {
                            Swal.fire({
                                icon: "error",
                                title: "Hata",
                                text: response.message
                            });
                        }
                    },
                    error: function () {
                        Swal.fire({
                            icon: "error",
                            title: "Hata",
                            text: "Sistemsel bir sorun oluştu, lütfen daha sonra tekrar deneyiniz."
                        });
                    }
                });
            });
        }
    });
</script>